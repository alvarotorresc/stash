{
  "name": "@stash/extension",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && svelte-check --fail-on-warnings",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "5.1.0",
    "@wxt-dev/module-svelte": "2.0.5",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "@stash/client": "workspace:*",
    "@stash/core": "workspace:*",
    "@stash/reader": "workspace:*",
    "@stash/ui": "workspace:*"
  }
}
